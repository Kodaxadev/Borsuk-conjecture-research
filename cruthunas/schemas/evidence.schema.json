{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cruthunas://schemas/evidence.schema.json",
  "title": "Cruthúnas evidence record",
  "type": "object",
  "required": [
    "id",
    "claim_id",
    "type",
    "epistemic_class",
    "verification_state",
    "paths",
    "commands",
    "environment",
    "source_revision",
    "clean_room_verifier",
    "limitations"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"},
    "claim_id": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "REPRODUCTION",
        "PROOF_PACKAGE",
        "REDUCTION",
        "UNSAT_CERTIFICATE",
        "SEARCH_INFRASTRUCTURE",
        "SYMMETRY_REDUCTION",
        "SAT_WITNESS",
        "FORMAL_PROOF",
        "EXTERNAL_REVIEW"
      ]
    },
    "epistemic_class": {
      "enum": ["MATHEMATICAL", "COMPUTATIONAL", "HYBRID", "INFRASTRUCTURE"]
    },
    "verification_state": {
      "enum": [
        "UNCHECKED",
        "INTERNALLY_VERIFIED",
        "INDEPENDENTLY_REPRODUCED",
        "CERTIFICATE_CHECKED",
        "FORMALLY_VERIFIED",
        "EXTERNALLY_REVIEWED"
      ]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {"type": "object", "minProperties": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "clean_room_verifier": {"type": "boolean"},
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "sha256"],
        "properties": {
          "artifact": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
