{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cruthunas://schemas/transaction.schema.json",
  "title": "Cruthúnas dry-run transition transaction",
  "type": "object",
  "required": [
    "schema_version",
    "transaction_id",
    "dry_run",
    "claim_id",
    "expected_current_transition_id",
    "from_gate",
    "to_gate",
    "actor",
    "reason",
    "source_revision",
    "evidence_ids",
    "operations",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "transaction_id": {"type": "string", "pattern": "^TX-[A-Z0-9-]+$"},
    "dry_run": {"const": true},
    "claim_id": {"type": "string", "minLength": 1},
    "expected_current_transition_id": {"type": "string", "minLength": 1},
    "from_gate": {"type": "integer", "minimum": 1, "maximum": 5},
    "to_gate": {"type": "integer", "minimum": 2, "maximum": 6},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "path"],
        "properties": {
          "operation": {"enum": ["create", "update"]},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "status": {"enum": ["BLOCKED", "READY"]},
    "blocking_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
