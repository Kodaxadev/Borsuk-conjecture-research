{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cruthunas://schemas/transition.schema.json",
  "title": "Cruthúnas transition record",
  "type": "object",
  "required": [
    "id",
    "from_gate",
    "to_gate",
    "date",
    "actor",
    "reason",
    "evidence_ids",
    "source_revision",
    "bootstrap_import"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^T-[A-Z0-9-]+-[0-6]-[0-6]$"},
    "from_gate": {"type": "integer", "minimum": 0, "maximum": 6},
    "to_gate": {"type": "integer", "minimum": 1, "maximum": 6},
    "date": {"type": "string", "format": "date"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"},
      "uniqueItems": true
    },
    "source_revision": {"type": "string", "minLength": 1},
    "bootstrap_import": {"type": "boolean"}
  },
  "additionalProperties": false
}
